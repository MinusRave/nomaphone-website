---
// In-article call to action: points to the calling app.
import { APP_URL, APP_CTA_LABEL } from "@/consts";
import NotifyForm from "@/components/NotifyForm.astro";
import { rateText } from "@/lib/rates.mjs";

interface Props {
  variant?: "mid" | "end";
}
const { variant = "end" } = Astro.props;
---
<aside class="np-cta not-prose" data-variant={variant}>
  <img src="/pixel/phone.webp" alt="" width="96" height="88" loading="lazy" class="np-cta__art" />
  <div class="np-cta__body">
    <p class="np-cta__kicker">NomaPhone · the internet's public phone</p>
    {variant === "mid" ? (
      <p class="np-cta__title">Need to make this call now? Dial it from your browser.</p>
    ) : (
      <p class="np-cta__title">Call any landline or mobile from your browser. No app, no account, no SIM.</p>
    )}
    <p class="np-cta__text">
      Prepaid credit from $5, rate shown before you dial, billed per second. US numbers including toll-free {rateText("US", "landline")}.
      Outgoing calls only: NomaPhone doesn't give you a number or receive SMS.
    </p>
    <a class="np-cta__btn" href={APP_URL}>{APP_CTA_LABEL} →</a>
    <NotifyForm source={`blog_${variant}`} />
  </div>
</aside>

<style>
  .np-cta {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin: 2.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    background: var(--color-paper-2);
    box-shadow: 4px 4px 0 var(--color-ink);
  }
  .np-cta__art { width: 88px; height: auto; flex-shrink: 0; margin: 0 !important; }
  .np-cta__kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-orange);
    margin: 0 0 0.25rem !important;
  }
  .np-cta__title { font-weight: 800; font-size: 1.15rem; line-height: 1.3; margin: 0 0 0.4rem !important; color: var(--color-ink); }
  .np-cta__text { font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 0.9rem !important; }
  .np-cta__btn {
    display: inline-block;
    background: var(--color-green);
    color: var(--color-paper-2) !important;
    text-decoration: none !important;
    font-weight: 700;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
  }
  .np-cta__btn:hover { background: var(--color-signal-hover); }
  @media (max-width: 560px) {
    .np-cta { flex-direction: column; align-items: flex-start; }
    .np-cta__art { width: 64px; }
  }
</style>
