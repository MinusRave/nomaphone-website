---
// Former waitlist confirmation page. Kept so existing links keep working.
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.tsx";
import { APP_URL } from "@/consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Thank you | NomaPhone"
      description="Thanks for your interest in NomaPhone, the internet's public phone. You can now call any landline or mobile from your browser."
    />
    <meta name="robots" content="noindex" />
  </head>

  <body class="bg-background text-foreground">
    <Header client:load currentPath="/thank-you-page" />

    <main class="mx-auto max-w-2xl px-4 py-24 text-center">
      <h1 class="text-4xl font-extrabold">Thanks! NomaPhone is ready.</h1>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)]">
        No more waiting list: you can call any landline or mobile straight from your browser. No app, no account, no SIM.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={APP_URL}
          class="inline-block rounded-lg border-2 border-[var(--color-ink)] bg-[var(--color-green)] px-6 py-3 font-extrabold text-[var(--color-paper-2)] shadow-[4px_4px_0_var(--color-ink)]"
        >
          Make a call
        </a>
        <a href="/" class="inline-block rounded-lg border-2 border-[var(--color-ink)] px-6 py-3 font-extrabold">Back to home</a>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
