---
// Former pre-launch "founding credits" page. The pre-sale is over: this URL now explains how
// credit works in the live app. Kept (not redirected) so existing links keep working.
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header";
import Footer from "@/components/Footer.tsx";
import { APP_URL } from "@/consts";

const title = "Buy NomaPhone calling credit: $5, $10 or $20, never expires";
const description =
  "NomaPhone credit is prepaid: $5, $10 or $20 with Apple Pay, Google Pay or card. It never expires, can be topped up, and unused credit is refundable any time.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-background text-foreground">
    <Header client:load currentPath="/reserve-credits" />

    <main class="mx-auto max-w-3xl px-4 py-16">
      <p class="font-mono text-sm uppercase tracking-wider text-[#b8531c]">Credit</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Buy credit, dial, talk.</h1>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)]">
        The pre-launch credit reservation has closed. NomaPhone is now a pay-as-you-go phone in your browser: you buy
        credit directly in the app, when you need it.
      </p>

      <ul class="mt-8 space-y-3 text-base">
        <li><strong>$5, $10 or $20</strong>, paid with Apple Pay, Google Pay or card.</li>
        <li>You get a phone card code (like <code class="font-mono">CAB-XXXX-XXXX-XXXX</code>) that holds the credit. It's also emailed to you.</li>
        <li>Credit <strong>never expires</strong> and the same card can be topped up.</li>
        <li>Unused credit can be <strong>refunded any time, free</strong>, to the original payment method.</li>
        <li>Calls are billed per second at the rate shown on screen as you dial. See <a class="underline text-[var(--color-signal)]" href="/rates/">rates by country</a>.</li>
      </ul>

      <p class="mt-8 text-[var(--color-text-secondary)]">
        Reserved credits before launch? Write to
        <a class="underline text-[var(--color-signal)]" href="mailto:support@nomaphone.com">support@nomaphone.com</a>
        from the email you paid with and we'll sort it out.
      </p>

      <a
        href={APP_URL}
        class="mt-10 inline-block rounded-lg border-2 border-[var(--color-ink)] bg-[var(--color-green)] px-6 py-3 font-extrabold text-[var(--color-paper-2)] shadow-[4px_4px_0_var(--color-ink)]"
      >
        Make a call
      </a>
    </main>

    <Footer client:load />
  </body>
</html>
